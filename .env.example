# Squared Away — environment variables
# Copy to .env.local for local dev. Never commit real values.
# In Vercel: Project → Settings → Environment Variables.
# Variables marked (Mn) are first needed in Milestone n.

# ── App ──────────────────────────────────────────────────────────────
# Public base URL of the app, no trailing slash. Local: http://localhost:3000
# Production: the domain Davi gives us (Vercel → Project → Settings → Domains).
APP_URL=http://localhost:3000
# Where customers write for help. Davi provides this. Shown in the site footer, the account status
# banner, the not-invited page and the privacy policy / terms. Empty = phone number only
# (see docs/SETUP.md §6f).
SUPPORT_EMAIL=
# The only address allowed into /admin. (M6)
ADMIN_EMAIL=

# ── Database (Neon Postgres) ─────────────────────────────────────────
# Neon console → your project → Connect → "Pooled connection" string. (M1)
# Local dev: postgres://sa:sa@localhost:5432/squared_away (see docs/SETUP.md)
DATABASE_URL=

# ── Auth (Auth.js + Google) ──────────────────────────────────────────
# Random 32+ byte secret. Generate with: openssl rand -base64 32 (M1)
AUTH_SECRET=
# Only needed outside Vercel (local `pnpm start`, CI). Vercel handles this automatically.
AUTH_TRUST_HOST=true
# Google Cloud console → APIs & Services → Credentials → OAuth 2.0 Client ID
# (type: Web application). Add BOTH authorized redirect URIs: (M1)
#   {APP_URL}/api/auth/callback/google   <- sign-in
#   {APP_URL}/api/gmail/callback          <- connecting Gmail
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── Token encryption ─────────────────────────────────────────────────
# 32-byte key, base64. Encrypts Gmail refresh tokens (AES-256-GCM).
# Generate with: openssl rand -base64 32 — losing it means every mailbox must reconnect. (M1)
TOKEN_ENCRYPTION_KEY=

# ── Gmail push (Google Cloud Pub/Sub) ────────────────────────────────
# Optional: without these we fall back to polling every 5 minutes. (M2)
# Google Cloud console → Pub/Sub → Topics → full name, e.g. projects/my-proj/topics/gmail-push
GMAIL_PUBSUB_TOPIC=
# Shared secret appended to the push subscription URL so we can reject forged pushes:
#   {APP_URL}/api/gmail/push?token={GMAIL_PUSH_VERIFICATION_TOKEN}
# Generate with: openssl rand -hex 24
GMAIL_PUSH_VERIFICATION_TOKEN=

# ── Background jobs (Inngest) ────────────────────────────────────────
# Production: install the Inngest integration from the Vercel Marketplace; it sets both keys.
# Or app.inngest.com → your app → Manage → Keys. (M2)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Local only: set to 1 and run `npx inngest-cli@latest dev` to use the local dev server.
INNGEST_DEV=

# ── AI (Anthropic) ───────────────────────────────────────────────────
# console.anthropic.com → Settings → API Keys → Create Key. (M3)
ANTHROPIC_API_KEY=
# Per-workspace daily cap on AI calls. Alert at 80%. (M3)
AI_DAILY_CALL_CAP=500

# ── Transactional email (Resend) ─────────────────────────────────────
# resend.com → API Keys → Create API Key. (M8)
RESEND_API_KEY=
# Verified sender, e.g. "Squared Away <digest@yourdomain.com>" (resend.com → Domains). (M8)
EMAIL_FROM=

# ── Billing (Stripe) ─────────────────────────────────────────────────
# dashboard.stripe.com → Developers → API keys → Secret key. Test key (sk_test_) until launch.
# Then /admin → Payments → Connect Stripe creates the prices, billing portal and webhook.
STRIPE_SECRET_KEY=
# Optional. Connect Stripe stores the webhook signing secret (encrypted) in the database;
# set this only to override it (e.g. `stripe listen` locally).
STRIPE_WEBHOOK_SECRET=

# ── Text alerts (Twilio) ─────────────────────────────────────────────
# Optional. Without these the Text alerts section says "not switched on yet".
# console.twilio.com → Account info (Account SID + Auth Token).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Messaging → Services → your service SID (MG…). Preferred: handles STOP/HELP + A2P 10DLC.
TWILIO_MESSAGING_SERVICE_SID=
# Or, for quick testing only, a Twilio number in E.164 (+1…).
TWILIO_FROM_NUMBER=

# ── Phone notifications (web push) ───────────────────────────────────
# Optional. Without VAPID_PUBLIC_KEY the phone-notification switch in Settings is hidden, and
# without both keys nothing is sent. One P-256 key pair, base64url (docs/SETUP.md "Phone
# notifications (VAPID)" has a one-line generator). Keep the private key secret (sensitive).
# After changing the pair, each phone has to switch notifications off and on again.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional contact the push services can reach us at: mailto:you@example.com or an https URL.
# Defaults to APP_URL.
VAPID_SUBJECT=

# ── Monitoring (Sentry) ──────────────────────────────────────────────
# sentry.io → your Next.js project → Settings → Client Keys (DSN). Optional; without it error
# alerts are off. Public by design (it can only send errors). Needs a redeploy (inlined at build).
NEXT_PUBLIC_SENTRY_DSN=

# ── Feature switches ─────────────────────────────────────────────────
# Off unless set. "1", "true" or "on" turns one on; empty means off.
# Plan #26 closing question (Davi turned it on in Vercel, Production + Preview, 2026-10-14)
FEATURE_CLOSING_QUESTION=
# Plan #47 referral credit (ask Davi; also needs REFERRAL_CREDIT_CENTS in src/config/pricing.ts)
FEATURE_REFERRALS=

# ── Data retention ───────────────────────────────────────────────────
# Days to keep email bodies before purging (metadata and summaries are kept). (M11)
RETENTION_BODY_DAYS=30

# ── End-to-end tests (set by playwright.config.ts; never set on Vercel) ─
# Playwright sets these itself for the app it starts, pointing it at local fake Google and
# Anthropic servers (src/config/e2e.ts). They are ignored on Vercel and unless DATABASE_URL is
# on this machine. Leave them out of .env.local and never add them in Vercel.
# SA_E2E=1
# SA_E2E_GOOGLE_BASE_URL=http://127.0.0.1:3101/google
# SA_E2E_ANTHROPIC_BASE_URL=http://127.0.0.1:3101/anthropic
# SA_E2E_HOOK_SECRET=
